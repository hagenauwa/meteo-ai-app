{
  "name": "meteo-ai-app",
  "version": "1.0.0",
  "description": "Web app meteo italiana con backend FastAPI, ML server-side e frontend statico su Netlify",
  "main": "index.html",
  "scripts": {
    "dev": "node scripts/dev-local.js",
    "dev:frontend": "node scripts/dev-local.js --frontend-only",
    "dev:backend": "node scripts/dev-local.js --backend-only",
    "dev:netlify": "npx --yes netlify-cli@27.1.2 dev",
    "dev:live": "npx --yes netlify-cli@27.1.2 dev --live",
    "dev:backend:full": "node scripts/dev-local.js --backend-full",
    "check": "npm run check:py && npm run check:js && npm run check:backend && npm run build",
    "check:py": "ruff check --config meteo-backend/pyproject.toml $(git ls-files '*.py') && ruff format --check --config meteo-backend/pyproject.toml $(git ls-files '*.py')",
    "check:js": "biome check public/js scripts tests/e2e",
    "check:backend": "cd meteo-backend && ./.venv/bin/python -m pytest -q",
    "format": "npm run format:py && npm run format:js",
    "format:py": "ruff format --config meteo-backend/pyproject.toml $(git ls-files '*.py')",
    "format:js": "biome format --write public/js scripts tests/e2e",
    "precommit": "uvx pre-commit run --all-files",
    "audit:code": "fallow audit --root . --format compact",
    "health:code": "fallow health --root . --format compact",
    "dead-code": "fallow dead-code --root . --format compact",
    "build": "echo 'Static site - no build needed'",
    "test:e2e": "playwright test",
    "deploy": "npx --yes netlify-cli@27.1.2 deploy --prod"
  },
  "keywords": [
    "meteo",
    "previsioni",
    "machine-learning",
    "fastapi",
    "open-meteo",
    "netlify",
    "render"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.63.0",
    "cross-env": "^7.0.3",
    "fallow": "^2.96.0"
  }
}
