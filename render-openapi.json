rch bar shortcut text */\n.rm-SearchToggle-shortcut {\n    font: normal normal normal 10px/12px Inter !important;\n    color: #232A55 !important;\n}\n\n/*\n** SIDEBAR\n*/\n\n.hub-sidebar {\n    flex: 0 0 264px !important;\n}\n\n/* Sidebar main section */\ndiv[class*=' Main-QuickNav'],div[class^='Main-QuickNav'] {\n    padding-left: 6px;\n}\n\n/* `Jump To` search */\nbutton[class*=' QuickNav'],button[class^='QuickNav'] {\n    border: 1px solid #e2e2e2;\n    border-radius: 0px;\n    opacity: 1;\n    color: #232A55;\n    text-align: left;\n    font: normal normal normal 10px/12px Inter;\n    letter-spacing: 0px;\n    height: 30px;\n    width: 249px;\n    padding-left: 16px;\n    padding-right: 18px;\n}\n\n/* `Jump To` search shortcut icon */\nspan[class*=' QuickNav-key'],span[class^='QuickNav-key'] {\n    border: none;\n    background: none;\n    font: normal normal normal 10px/12px Inter;\n}\n\n/* Remove top header from sidebar */\nh3[class*=' Sidebar-heading'] {\n  display: none; \n}\n\nh2[class^='Sidebar-heading'] {\n  text-transform: none !important;\n  color: #000 !important;\n  font-weight: 600 !important;\n  font-size: 15px !important;\n  margin-bottom: 5px;\n}\n\n/* Sidebar section header styling  */\na[class*=' Sidebar-link_parent'],a[class^='Sidebar-link_parent'] {\n    color: #181B38 !important;\n    font: normal normal 400 14px/16px Inter !important;\n    opacity: 1;\n    margin-bottom: 3px;\n}\n\n/* Sidebar body */\n.rm-Sidebar {\n    padding-left: 12px;\n}\n\n/* Sublists below sections */\n.subpages {\n    margin-bottom: 29px !important;\n}\n\n/* Endpoint list items in sidebar */\n.rm-Sidebar-link.childless {\n    font: normal normal normal 13px/19px Inter !important;\n    letter-spacing: 0px;\n    color: #232A55;\n    margin-left: 0px !important;\n    margin-bottom:0px;\n}\n\n.rm-Sidebar-section {\n  margin-top: 0px !important;\n  margin-bottom: 10px\n}\n\n\n.rm-Sidebar-list {\n  margin-bottom: 5px !important;\n}\n\n\n/*\n** BODY\n*/\n\n/* Headline container */\nheader[class*= ' headline-container'],header[class^='headline-container'] {\n    padding-bottom: 32px;\n}\n\n/* Title */\ndiv[class*=' headline-container-grid-item'] h1,div[class^='headline-container-grid-item'] h1 {\n    font: normal normal 300 35px/40px Inter !important;\n    color: #181B38 !important;\n    margin-bottom: 16px;\n}\n\n/* API Method in headline */\nspan[class*=' headline-container-api-method'],span[class^='headline-container-api-method'] {\n    margin-right: 12px;\n}\n\n/* Endpoint URL */\nspan[class*=' headline-container-article-info-url'],span[class^='headline-container-article-info-url'] {\n    font: normal normal normal 14px/17px Inter;\n    color: #232A55;\n    margin-top: 2px;\n}\n\n/* Doc Subtitle */\ndiv[role=\"doc-subtitle\"] {\n    margin-top: 34px !important;\n    font: normal normal normal 15px/23px Inter !important;\n    color: #181B38;\n}\n\n/* Reference section */\ndiv.Reference-section {\n    margin-top: 20px;\n}\n\n/* API Section Header headings */\nstrong[class*=' APISectionHeader-heading'],strong[class^='APISectionHeader-heading'] {\n    font: normal normal 600 13px/16px Inter;\n    color: #181B38;\n    letter-spacing: 0.52px;\n}\n\n/**\n * REQUEST HISTORY\n**/\n\n/* Request History Card */\ndiv.rm-APILogInfo {\n    background: #FFFFFF 0% 0% no-repeat padding-box;\n    border: 1px solid #ECF1F9;\n    border-radius: 10px;\n}\n\n/* Request History Card Header */\nbutton[class*=' APILogInfo-button'],button[class^='APILogInfo-button'] {\n    background: #F7F8FA 0% 0% no-repeat padding-box;\n    border: 1px solid #ECF1F9;\n    border-radius: 10px 10px 0px 0px;\n    padding: 13px 12px 13px 18px;\n}\n\n/* Request History # of calls text */\nspan[class*=' APILogInfo-button-calls'],span[class^='APILogInfo-button-calls'] {\n    font: normal normal 600 14px/28px Inter;\n    color: #181B38;\n}\n\n/* Request History timespan button */\nbutton[class*=' APILogInfo-button'] select,button[class^='APILogInfo-button'] select{\n    font: normal normal 600 14px/28px Inter;\n    color: #181B38;\n    background-image: url(data:image/svg+xml;base64,);\n    background-size: 6px;\n    padding-right: 16px;\n}\n\n/* Request History empty content */\ndiv[class*=' APILogInfo-empty-bottom'],div[class^='APILogInfo-empty-bottom'] {\n    font: normal normal normal 14px/17px Inter;\n    color: #232A55;\n    padding: 11px 18px 15px 18px;\n}\n\n/* Request History table */\ntable[class*=' LogsTable'] thead th,table[class^='LogsTable'] thead th {\n    font-family: Inter !important;\n}\n\n/* Request History footer button */\nbutton[class*=' APILogsTable-footer-button'],button[class^='APILogsTable-footer-button'] {\n    font-family: Inter;\n}\n\n/*\n** PATH PARAMS\n*/\n\n/* Param container sections */\n.rm-ParamContainer{\n    overflow-x: scroll;\n}\n\n\n/* Individual param container */\ndiv[class*=' Param'].form-group.field,div[class^='Param'].form-group.field {\n    padding: 18px 15px 18px 18px;\n}\n\n/* These two selectors allow the parameter fields to reflow whole rather than being cut off */\n\n/* Param left */\ndiv[class*=' Param-left'],div[class^='Param-left'] {\n    flex-wrap: wrap;\n}\n\n/* Param header */\ndiv[class*=' Param-header'],div[class^='Param-header'] {\n    flex-wrap: wrap !important;\n}\n\n/* Param name */\nlabel[class*=' Param-name'],label[class^='Param-name'] {\n    font: normal normal bold 14px/30px Hack;\n    color: #181B38;\n    margin-right: 10px !important;\n}\n\n/* Param type */\ndiv[class*=' Param-type'],div[class^='Param-type'] {\n    font: normal normal 400 13px/16px Inter;\n    color: #98A2B8;\n    margin-right: 10px !important;\n}\n\n/* Param required */\ndiv[class*=' Param-required'],div[class^='Param-required'] {\n    text-transform: uppercase;\n    font: normal normal bold 11px/21px Inter;\n    color: #FF5C88;\n}\n\n/* Param form */\ndiv[class*=' Param-form'],div[class^='Param-form'] {\n    max-width: 168px;\n}\n\n/* Param input */\n.rm-ParamInput {\n    border: 1px solid #BDC2D1 !impor